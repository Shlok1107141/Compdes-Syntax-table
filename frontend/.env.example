# Frontend build settings. Copy to frontend/.env only if you need to change them;
# Vite reads frontend/.env automatically. Both are optional.

# Where the browser sends API requests. The default '/api' works with `npm run dev`
# (Vite forwards /api to http://localhost:8000) and with docker compose (nginx forwards it).
# VITE_API_URL=/api

# Base path the site is served from. '/' locally; the GitHub Pages workflow builds with
# VITE_BASE=/Compdes-Syntax-table/ (set in the shell, not in this file).
# VITE_BASE=/
