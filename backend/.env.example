# Backend settings. Copy to backend/.env (scripts/setup.sh does this) and edit as needed.
# Every variable is optional: the values below are the built-in defaults.
# scripts/run.sh loads backend/.env; docker-compose.yml sets its own values.
# No secrets are needed anywhere in this project.

# Browser origins allowed to call the API (CORS), comma-separated.
SYMTAB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Largest accepted source text in bytes (larger requests get HTTP 413).
SYMTAB_MAX_CODE_BYTES=65536

# Requests per client per minute (more get HTTP 429).
SYMTAB_RATE_LIMIT=30

# Analyses allowed to run at the same time.
SYMTAB_MAX_CONCURRENCY=4

# Seconds before an analysis is stopped (HTTP 504).
SYMTAB_ENGINE_TIMEOUT=5

# Set to 1 only behind a reverse proxy that sets X-Real-IP (the Docker stack does this).
SYMTAB_TRUST_PROXY_HEADERS=0

# Path to the analyzer binary. Empty = engine/symtab_analyze (built by `make -C engine`).
SYMTAB_ENGINE=

# Parse-table compression suite: binary path (empty = engine/syntax_bench) and time limit.
SYNTAX_ENGINE=
SYNTAX_ENGINE_TIMEOUT=10

# Optional hardware: serial port and baud rate of the ESP32 board (the Arduino Uno port
# is chosen in the web page instead).
ESP32_PORT=COM6
ESP32_BAUD=115200
